{
  "mrfz_data_path": {
    "description": "明日方舟角色数据(插件自带,可以通过修改文件来修改随机池)",
    "type": "string",
    "default": "./data/plugins/astrbot_plugin_mrfzccl/arknights_skins_dict.json",
    "hint": "例如：/home/user/arknights_skins_dict.json"
  },
  "target_size": {
    "description": "角色立绘最后输出的参考大小",
    "type": "int",
    "default": 512,
    "hint": "例如：512"
  },
  "db_path": {
    "description": "数据库存储位置(为空为astrbot的默认存储位置)",
    "type": "string",
    "default": "",
    "hint": "例如：/home/user/db"
  }
}
